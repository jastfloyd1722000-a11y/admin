page { background:#f5f7ff; color:#1f2a44; }
.container { padding: 24rpx; }
.card { background:#fff; border:1px solid #e3e8ff; border-radius:16rpx; padding:20rpx; margin-bottom:16rpx; }
.title { font-size:36rpx; font-weight:700; margin-bottom:8rpx; }
.sub { color:#7b87a8; font-size:26rpx; margin-bottom:20rpx; }
.chips{ display:flex; flex-wrap:wrap; gap:12rpx; }
.chip{ padding:10rpx 20rpx; border:1px solid #cad3ff; border-radius:999rpx; font-size:26rpx; }
.chip.on{ background:#e9edff; color:#3f4ae0; border-color:#7583ff; }
.btn{ background:#5b6cff; color:#fff; border-radius:12rpx; padding:16rpx; text-align:center; margin-top:16rpx; }
.btn.secondary{ background:#fff; border:1px solid #cad3ff; color:#5b6cff; }
.grid{ display:grid; grid-template-columns:1fr 1fr; gap:12rpx; }
.kpi{ display:grid; grid-template-columns:1fr 1fr; gap:12rpx; }
